# Copy to .env.local (local) and set the same names in the Vercel dashboard (production).
# Server-side only: read by the /api proxy functions, never sent to the browser.
N8N_BASE_URL=https://luwisiii.app.n8n.cloud
N8N_LEAD_PATH=/webhook/lead-demo/intake
N8N_STATS_PATH=/webhook/lead-demo/stats
N8N_CHAT_PATH=
# Value of the n8n Header Auth credential (header X-Demo-Key)
N8N_DEMO_KEY=
N8N_CHAT_AUTH=
